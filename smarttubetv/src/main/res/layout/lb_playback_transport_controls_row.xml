<?xml version="1.0" encoding="utf-8"?>
<!-- Private TV controls: retain presenter IDs and seek callbacks. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false"
    android:paddingBottom="12dp">
    <com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.playerglue.tweaks.PlaybackTransportRowView
        android:id="@+id/transport_row" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="48dp" android:paddingEnd="48dp"
        android:clipChildren="false" android:clipToPadding="false">
        <LinearLayout android:id="@+id/top_edge" android:layout_width="match_parent"
            android:layout_height="1dp" android:orientation="horizontal" android:focusable="true"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="100dp">
            <LinearLayout android:id="@+id/controls_card" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_gravity="bottom"
                android:layout_marginBottom="20dp" android:orientation="horizontal">
                <ImageView android:id="@+id/image" android:layout_width="0dp" android:layout_height="0dp"/>
                <FrameLayout android:id="@+id/description_dock" android:layout_width="560dp"
                    android:layout_height="wrap_content" android:clipToPadding="false"/>
            </LinearLayout>
            <FrameLayout android:id="@+id/secondary_controls_dock" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="bottom|end"
                android:layout_marginBottom="16dp"/>
            <LinearLayout android:id="@+id/thumbs_row_wrapper" android:visibility="invisible"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="bottom" android:orientation="vertical">
                <com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.playerglue.seekpreview.ThumbsBar
                    android:id="@+id/thumbs_row" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal"/>
                <TextView android:id="@+id/thumbs_row_title" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
                    android:visibility="gone" style="?attr/playbackControlsTimeStyle"/>
            </LinearLayout>
        </FrameLayout>
        <com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.misc.SeekBar
            android:id="@+id/playback_progress" android:layout_width="match_parent"
            android:layout_height="24dp" android:focusable="true" android:focusableInTouchMode="true"/>
        <FrameLayout android:id="@+id/time_info" android:layout_width="match_parent" android:layout_height="32dp">
            <RelativeLayout android:id="@+id/current_time_wrapper" android:layout_width="match_parent"
                android:layout_height="match_parent" android:layoutDirection="ltr">
                <TextView android:id="@+id/current_time" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_alignParentStart="true"
                    android:layout_centerVertical="true" android:textSize="12sp" android:textColor="#AAAAAA"/>
                <TextView android:id="@+id/total_time" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" android:textSize="12sp" android:textColor="#AAAAAA"/>
            </RelativeLayout>
        </FrameLayout>
        <!-- Presenter-owned legacy controls remain bound; the TV surface uses the action row above. -->
        <FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
            <FrameLayout android:id="@+id/controls_dock" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <LinearLayout android:id="@+id/additional_info" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:id="@+id/quality_info" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.time.DateTimeView android:id="@+id/date_time"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView android:id="@+id/ending_time" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/separate_time" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </FrameLayout>
    </com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.playerglue.tweaks.PlaybackTransportRowView>
</LinearLayout>
